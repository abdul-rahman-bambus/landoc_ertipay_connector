<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_ertipay" model="ir.ui.view">
        <field name="name">account.move.form.ertipay</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ertipay" invisible="not payment_transaction_id">
                    <group>
                        <group string="Gateway Reconciliation">
                            <field name="payment_transaction_id"/>
                            <field name="ertipay_transaction_fee"/>
                            <field name="ertipay_gst"/>
                            <field name="ertipay_total_paid"/>
                            <field name="ertipay_received_amount"/>
                            <field name="ertipay_amount_mismatch"/>
                            <field name="ertipay_session_id"/>
                            <field name="ertipay_payment_reference"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            Ertipay commission and GST are stored for payout reconciliation only;
                            they are not included in the Landoc invoice total.
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
