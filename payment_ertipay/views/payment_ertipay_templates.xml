<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_to_upi" name="Redirect to Ertipay UPI">
        <t t-call="website.layout">
            <div class="container py-4 py-md-5">
                <div class="row justify-content-center">
                    <div class="col-12 col-sm-10 col-md-8 col-lg-6 text-center">
                        <h2 class="h3 mb-3">Complete your payment with Ertipay UPI</h2>
                        <t t-if="intent_link and intent_link.startswith('upi:')">
                            <p class="text-muted mb-2">Opening your UPI application. If it does not open automatically, use the button below.</p>
                            <a id="ertipay_upi_intent" t-att-href="intent_link" class="btn btn-primary btn-lg d-block d-sm-inline-block my-3">Open UPI App</a>
                            <script type="text/javascript">
                                document.addEventListener('DOMContentLoaded', function () {
                                    const upiIntent = document.getElementById('ertipay_upi_intent');
                                    if (upiIntent) {
                                        window.location.href = upiIntent.href;
                                    }
                                });
                            </script>
                        </t>
                        <t t-elif="intent_link and intent_link.startswith('http')">
                            <p class="text-muted">Scan this QR code with any UPI app to complete the payment.</p>
                            <div class="my-3">
                                <img t-att-src="intent_link" alt="Ertipay UPI QR Code" class="img-fluid border rounded p-2 bg-white w-100" style="max-width: 320px;"/>
                            </div>
                            <a t-att-href="intent_link" target="_blank" class="btn btn-outline-primary d-block d-sm-inline-block my-2">Open QR Code</a>
                        </t>
                        <t t-else="">
                            <p class="alert alert-warning">Ertipay did not provide a UPI intent link or QR code for this transaction. Please try again or contact support.</p>
                        </t>
                        <p class="small text-muted mt-3">After payment, you can return to this page. Odoo will update the quotation after Ertipay confirms the payment.</p>
                        <a href="/payment/status" class="btn btn-link">Check payment status</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="redirect_form" name="Redirect Form for Ertipay UPI">
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="intent_link" t-att-value="intent_link"/>
            <input type="hidden" name="reference" t-att-value="reference"/>
            <button type="submit" class="btn btn-primary d-none">Pay with Ertipay</button>
        </form>
    </template>


    <template id="payment_method_form_inherit" name="Payment Method Form Inherit"
          inherit_id="payment.method_form">

        <xpath expr="//label[@t-out='pm_sudo.name']" position="attributes">
            <attribute name="class" add="text-nowrap flex-shrink-0" separator=" "/>
        </xpath>
        <xpath expr="//label[@t-out='pm_sudo.name']/.." position="attributes">
            <attribute name="class" add="flex-wrap" separator=" "/>
        </xpath>

        <xpath expr="//label[@t-out='pm_sudo.name']" position="after">

            <!-- Do not overwrite payment.method_form's provider_sudo variable: the
                 base template uses it later for tokenization mappings. -->
            <t t-set="ertipay_provider_sudo"
               t-value="pm_sudo.provider_ids.filtered(lambda p: p in providers_sudo and p.code == 'ertipay')[:1]"/>
            <t t-if="ertipay_provider_sudo and ertipay_provider_sudo.is_trn_charges_applied">
                <t t-set="ertipay_charge_values"
                   t-value="ertipay_provider_sudo._calculate_total_payable(request.params.get('order_id'), request.params.get('downpayment'))"/>
                <!-- The method name and this summary share a flex container in
                     payment.method_form. A full flex basis keeps the summary on
                     its own row instead of squeezing "Ertipay" letter-by-letter. -->
                <div class="bg-light border rounded mt-2 p-2 w-100 text-start"
                     style="flex: 0 0 100%; min-width: 0;"
                     t-if="ertipay_charge_values">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <strong>Landoc amount:</strong>
                        <span class="flex-shrink-0 text-end" t-out="ertipay_charge_values['amount']"
                              t-options="{'widget': 'monetary', 'display_currency': ertipay_charge_values['currency']}"/>
                    </div>
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <strong>Ertipay commission:</strong>
                        <span class="flex-shrink-0 text-end" t-out="ertipay_charge_values['transaction_fee']"
                              t-options="{'widget': 'monetary', 'display_currency': ertipay_charge_values['currency']}"/>
                    </div>
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <strong>GST on commission:</strong>
                        <span class="flex-shrink-0 text-end" t-out="ertipay_charge_values['gst']"
                              t-options="{'widget': 'monetary', 'display_currency': ertipay_charge_values['currency']}"/>
                    </div>
                    <div class="d-flex justify-content-between align-items-start gap-2 border-top mt-2 pt-2">
                        <strong>Total payable through Ertipay:</strong>
                        <span class="flex-shrink-0 text-end fw-bold" t-out="ertipay_charge_values['total']"
                              t-options="{'widget': 'monetary', 'display_currency': ertipay_charge_values['currency']}"/>
                    </div>
                    <small class="text-muted d-block mt-2">Gateway charges are not added to the Landoc invoice.</small>
                </div>
            </t>

        </xpath>

    </template>
</odoo>
