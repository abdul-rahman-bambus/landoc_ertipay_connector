<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_transaction_form_ertipay" model="ir.ui.view">
        <field name="name">payment.transaction.form.ertipay</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ertipay_fetch_status"
                        string="Fetch Ertipay Status"
                        type="object"
                        class="btn-primary"
                        invisible="provider_code != 'ertipay' or state in ('done', 'cancel')"
                        confirm="Fetch the latest status from Ertipay and process the decrypted response?"/>
                <button name="action_ertipay_simulate_uat_success"
                        string="UAT Mark Successful"
                        type="object"
                        class="btn-primary"
                        invisible="provider_code != 'ertipay' or ertipay_provider_state != 'test' or state in ('done', 'cancel')"
                        confirm="Mark this Ertipay UAT transaction successful, then fetch and process its status?"/>
                <button name="action_ertipay_simulate_uat_failure"
                        string="UAT Mark Failed"
                        type="object"
                        invisible="provider_code != 'ertipay' or ertipay_provider_state != 'test' or state in ('done', 'cancel')"
                        confirm="Mark this Ertipay UAT transaction failed, then fetch and process its status?"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Ertipay">
                        <group>
                            <group>
                                <field name="ertipay_txn_id"/>
                                <field name="ertipay_txn_ref_id"/>
                                <field name="ertipay_intent_link"/>
                                <field name="ertipay_transaction_fee"/>
                                <field name="ertipay_gst"/>
                                <field name="ertipay_total_paid"/>
                                <field name="ertipay_fee_percentage"/>
                                <field name="ertipay_gst_percentage"/>
                                <field name="ertipay_received_amount"/>
                                <field name="ertipay_amount_mismatch"/>
                                <field name="ertipay_session_id"/>
                                <field name="ertipay_payment_reference"/>
                                <field name="ertipay_raw_response"/>
                                <field name="ertipay_provider_state" invisible="1"/>
                            </group>
                        </group>

                    </page>
                </notebook>
            </xpath>

        </field>
    </record>
</odoo>
